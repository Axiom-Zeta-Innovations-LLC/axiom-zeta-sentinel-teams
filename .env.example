GATEWAY_API_KEY=replace-me
DETERMINISTIC_MODE=true
DRIFT_ENGINE_SEED=7
DRIFT_SPIKE_THRESHOLD=0.80
DRIFT_BREAKER_TRIP_COUNT=3
MAX_METRIC_WINDOW=4096
MAX_COMPUTE_STEPS=50000
ALLOW_INSECURE_NO_AUTH=false
MAX_TENANTS=1000
BASELINE_WINDOWS=5
# HMAC secret your dashboard/back end uses to sign X-User-Id (X-User-Signature). Keep it separate from GATEWAY_API_KEY.
USER_ID_SIGNING_SECRET=replace-with-random-secret
ALLOW_UNSIGNED_USER_ID=false
